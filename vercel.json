{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/appointments", "destination": "/api/admin?section=appointments" },
    { "source": "/api/income", "destination": "/api/admin?section=income" },
    { "source": "/api/categories", "destination": "/api/admin?section=catalogs&type=categories" },
    { "source": "/api/services", "destination": "/api/admin?section=catalogs&type=services" },
    { "source": "/api/staff", "destination": "/api/admin?section=catalogs&type=staff" },
    { "source": "/api/clients", "destination": "/api/admin?section=clients" },
    { "source": "/api/leads/identify", "destination": "/api/admin?section=identify" },
    { "source": "/api/leads/chat", "destination": "/api/admin?section=tracking" },
    { "source": "/api/leads", "destination": "/api/admin?section=leads" },
    { "source": "/api/appointments", "destination": "/api/admin?section=appointments" },
    { "source": "/api/dashboard", "destination": "/api/admin?section=dashboard" },
    { "source": "/api/(.*)", "destination": "/api/admin?section=$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
