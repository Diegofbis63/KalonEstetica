{
    "rewrites": [
        {
            "source": "/api/messages/pending",
            "destination": "/api/leads/chat?action=pending"
        },
        {
            "source": "/api/messages/mark-sent",
            "destination": "/api/leads/chat?action=mark-sent"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}